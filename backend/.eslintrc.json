{
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-unused-vars": "warn",
    "no-undef": "error",
    "no-console": "warn",
    "no-debugger": "error",
    "eqeqeq": "warn"
  }
}