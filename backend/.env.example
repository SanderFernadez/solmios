# ─── Server ─────────────────────────────────────────────
PORT=3000

# ─── JWT (OBLIGATORIO, mínimo 16 caracteres) ───────────
# Generar con: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secret-aleatorio-de-32-chars

# ─── Base de datos ─────────────────────────────────────
# Motor actual: SQLite. El backend abre data/managerhotel.db directo (composition-root).
# El CLI de migraciones (arckode db:migrate) detecta el motor por:
#   DATABASE_URL → postgres · DB_HOST → mysql · DB_PATH → sqlite (fallback)
DB_PATH=data/managerhotel.db

# PostgreSQL — reservado para migración futura a producción (NO activo).
# Para activarlo: comentar DB_PATH arriba y descomentar estas vars.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=managerhotel
# DB_USER=managerhotel
# DB_PASSWORD=managerhotel

# ─── Channex (Channel Manager) ─────────────────────────
# Obtener en: https://staging.channex.io/ → Settings → API Keys
CHANNEX_BASE_URL=https://staging.channex.io/api/v1
CHANNEX_API_KEY=
CHANNEX_PROPERTY_ID=

# PC-3 Stripe (opcional — si no se configuran, los endpoints responden 503)
# Obtener en: https://dashboard.stripe.com/apikeys
# ─── Pasarelas de pago ────────────────────────────────────────────────────
# Master key para cifrar las credenciales de pasarela (payment_gateways) en la BD.
# Sin ella no se pueden guardar llaves de cobro. Generar con: openssl rand -base64 32
# ⚠ Si se pierde o se rota, las credenciales guardadas quedan ILEGIBLES y hay que recargarlas.
PAYMENTS_ENCRYPTION_KEY=

# Las STRIPE_* de abajo son el FALLBACK GLOBAL (cuenta de la plataforma) para hoteles que
# todavía no configuraron su pasarela en /panel/pagos. Cada hotel debería tener la suya:
# con estas cargadas, un hotel sin configurar cobra contra ESTA cuenta, no contra la suya.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Suscripción SaaS del hotel a la plataforma (distinto de lo de arriba, que es el hotel
# cobrando a SUS huéspedes). Requiere: 1) Products/Prices en el dashboard de Stripe
# (modo suscripción), 2) esos Price IDs copiados a plans.stripePriceId, 3) un webhook
# endpoint apuntando a POST /api/stripe/webhook/platform con este signing secret.
STRIPE_WEBHOOK_SECRET_PLATFORM=

# ── Captcha del registro público (Cloudflare Turnstile) ──────────────────────
# Protege /api/public/signup de bots que creen hoteles en masa. El rate-limit
# por IP no alcanza contra un ataque distribuido.
#
# ⚠ SIN esta clave el captcha queda DESACTIVADO y el alta solo está protegida
#   por rate-limit. El backend lo avisa por log al arrancar.
#
# Claves: https://dash.cloudflare.com → Turnstile → Add site (gratis).
# Genera un par: la SITE KEY (pública) va al build del frontend como
# VITE_TURNSTILE_SITE_KEY; el SECRET (privado) va acá y nunca al repo.
TURNSTILE_SECRET=

# ─── Booking engine público (solmi-direct-booking) ────────────────────────
# Toggle del flujo unificado de reserva (widget público → Stripe checkout).
# Si está vacío o `false`, el motor público usa el flujo legacy. Default: habilitado.
BOOKING_USE_UNIFIED_FLOW=true

# URL pública canónica del frontend del hotel (ej. https://hotel.zx89.site).
# Se usa para armar successUrl/cancelUrl de Stripe cuando el widget no las manda
# explícitamente, y para resolver el base URL del sitemap / JSON-LD. Sin esto,
# el backend deriva la base del header Host/Origin del request (frágil detrás de proxies).
PUBLIC_BASE_URL=

# App ID de OpenExchangeRates para conversión de moneda del widget público
# (GET /api/public/hotels/:slug/rates?currency=EUR). Sin esto, la conversión
# cae a la tasa cacheada en configuration('currency_rates') o devuelve la tarifa
# en la moneda base del hotel. https://openexchangerates.org/signup (free tier).
OPENEXCHANGERATES_APP_ID=
