# ─── Server ─────────────────────────────────────────────
PORT=3000

# ─── JWT (OBLIGATORIO, mínimo 16 caracteres) ───────────
# Generar con: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secret-aleatorio-de-32-chars

# ─── Base de datos ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=managerhotel
DB_USER=managerhotel
DB_PASSWORD=managerhotel

# ─── Channex (Channel Manager) ─────────────────────────
# Obtener en: https://staging.channex.io/ → Settings → API Keys
CHANNEX_BASE_URL=https://staging.channex.io/api/v1
CHANNEX_API_KEY=
CHANNEX_PROPERTY_ID=

# PC-3 Stripe (opcional — si no se configuran, los endpoints responden 503)
# Obtener en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
